pkgname=command-centre
pkgver=1.2.0
pkgrel=1
pkgdesc="CommandOS operations dashboard and Command Intel investigation workspace"
arch=('any')
url="https://github.com/ebfourie7-ops/Command-Centre"
license=('custom:Command-Centre')
depends=('python' 'python-cryptography' 'pyside6' 'qt6-webengine')
optdepends=('ollama: local evidence analysis' 'perl-image-exiftool: metadata inspection' 'nmap: authorized network discovery')
source=()
sha256sums=()

package() {
  install -d "$pkgdir/opt/command-centre" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications"
  cp -a "$startdir/../../command_centre.py" "$startdir/../../command_intel.py" "$startdir/../../splash.png" "$startdir/../../core" "$startdir/../../resources" "$startdir/../../tools" "$pkgdir/opt/command-centre/"
  install -Dm644 "$startdir/../../deployments/default_deployments.json" "$pkgdir/opt/command-centre/deployments/default_deployments.json"
  install -Dm644 "$startdir/../../command-centre-icon.png" "$pkgdir/opt/command-centre/logo.png"
  install -Dm644 "$startdir/../../command-centre-icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/command-centre.png"
  install -Dm644 "$startdir/../../command-centre-icon.png" "$pkgdir/usr/share/pixmaps/command-centre.png"
  printf '#!/bin/sh\nexec python /opt/command-centre/command_centre.py "$@"\n' > "$pkgdir/usr/bin/command-centre"
  chmod 755 "$pkgdir/usr/bin/command-centre"
  install -Dm644 "$startdir/command-centre.desktop" "$pkgdir/usr/share/applications/command-centre.desktop"
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
